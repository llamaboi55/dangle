{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dangle",
  "version": "1.0.0",
  "identifier": "io.github.llamaboi55.dangle",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "strip",
        "title": "Dangle charms",
        "url": "index.html",
        "width": 1200,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "Little charms that hang from the top of your screen.",
    "longDescription": "Dangle hangs little charms from the top of your screen. They swing on real rope physics when you brush past them, you can grab and fling them, and the hourglass charm is a focus timer. Free and open source, on Windows, macOS and Linux.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "deb": { "depends": [] }
    }
  },
  "plugins": {}
}
